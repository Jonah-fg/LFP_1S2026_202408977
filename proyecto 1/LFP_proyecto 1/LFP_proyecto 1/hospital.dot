digraph Hospital {
    graph [charset="UTF-8"];
    rankdir=TB;
    node [shape=box, style=filled, fontname="Arial"];

    H [label="Hospital General", fillcolor="#1A4731", fontcolor=white, shape=ellipse];

    P [label="PACIENTES", fillcolor="#2E7D52", fontcolor=white];
    M [label="MEDICOS", fillcolor="#2E7D52", fontcolor=white];
    C [label="CITAS", fillcolor="#2E7D52", fontcolor=white];
    D [label="DIAGNOSTICOS", fillcolor="#2E7D52", fontcolor=white];

    H -> P;H -> M; H -> C; H -> D;
    p0 [label="\"Ana Lopez\"\n34 anios\n\"O+\"", fillcolor="#D4EDDA"];
    P -> p0;
    p1 [label="\"Carlos Mendoza\"\n62 anios\n\"O-\"", fillcolor="#D4EDDA"];
    P -> p1;
    p2 [label="\"Maria Garcia\"\n45 anios\n\"A+\"", fillcolor="#D4EDDA"];
    P -> p2;
    p3 [label="\"Sofia Ramirez\"\n29 anios\n\"B+\"", fillcolor="#D4EDDA"];
    P -> p3;

   m0 [label="\"Dr. Roberto Juarez\"\n\"MED-001\"\nCARDIOLOGIA", fillcolor="#D6EAF8"];
    M -> m0;
   m1 [label="\"Dra. Ana Solis\"\n\"MED-002\"\nNEUROLOGIA", fillcolor="#D6EAF8"];
    M -> m1;
   m2 [label="\"Dr. Luis Herrera\"\n\"MED-003\"\nPEDIATRIA", fillcolor="#D6EAF8"];
    M -> m2;
   m3 [label="\"Dra. Carmen Vega\"\n\"MED-004\"\nCIRUGIA", fillcolor="#D6EAF8"];
    M -> m3;

   p0-> m0 [label="2025-04-10 09:00", color="#E67E22", style=dashed];
   p1-> m1 [label="2025-04-10 11:30", color="#E67E22", style=dashed];
   p2-> m0 [label="2025-04-10 09:00", color="#E67E22", style=dashed];
   p3-> m2 [label="2025-04-11 08:00", color="#E67E22", style=dashed];
   p0-> m3 [label="2025-04-12 14:00", color="#E67E22", style=dashed];

   d0 [label="\"Hipertension Arterial\"\n\"Losartan 50mg\"\nDIARIA", fillcolor="#FDEBD0"];
   D -> d0;
    d0 -> p0 [label="diagnostico activo", color="#C0392B"];
   d1 [label="\"Diabetes Tipo 2\"\n\"Metformina 850mg\"\nCADA_12_HORAS", fillcolor="#FDEBD0"];
   D -> d1;
    d1 -> p1 [label="diagnostico activo", color="#C0392B"];
   d2 [label="\"Insuficiencia Cardiaca\"\n\"Furosemida 40mg\"\nDIARIA", fillcolor="#FDEBD0"];
   D -> d2;
